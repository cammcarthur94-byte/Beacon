# ==============================================================================
# Beacon GEO Platform - Environment Configuration
# ==============================================================================

# Vercel Cron Secret (used to secure /api/cron/* endpoints)
CRON_SECRET=your_super_secret_cron_token_here

# Supabase Credentials (Service Role required for bypassing RLS during background audits)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Model Provider API Keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
PERPLEXITY_API_KEY=pplx-your_perplexity_api_key_here

# Premium Tier SERP Scraper Providers (Google AI Overviews & Copilot Search)
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here
FIRECRAWL_API_KEY=fc-your_firecrawl_api_key_here

# Stripe Billing & Subscription Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here

# Stripe Price IDs (created in your Stripe Dashboard)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_pro_monthly
NEXT_PUBLIC_STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

